ANTHROPIC_API_KEY=
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# Optional - the defaults in app/config.py work for local development.
# GOOGLE_CLIENT_SECRET_PATH=
# DATABASE_URL=
# UPLOADS_PER_DAY=10
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8000

# Deployed only - leave unset locally, where extraction runs as a FastAPI BackgroundTask.
# Setting the queue requires the other two (the app refuses to start otherwise).
# CLOUD_TASKS_QUEUE=projects/<project>/locations/us-west1/queues/extractions
# SERVICE_URL=https://<service>-<hash>-uw.a.run.app
# TASKS_SERVICE_ACCOUNT=tasks@<project>.iam.gserviceaccount.com
